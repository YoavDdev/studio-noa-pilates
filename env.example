# ========================================
# 🔐 Supabase Configuration
# ========================================
# Get these from: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ========================================
# 💳 PayPal Configuration
# ========================================
# Get these from: https://developer.paypal.com/dashboard/applications
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_secret_here
PAYPAL_MODE=live
# sandbox for testing, live for production

# Plan IDs - get from PayPal billing plans dashboard
NEXT_PUBLIC_PAYPAL_PLAN_ID_MONTHLY=P-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_PLAN_ID_YEARLY=P-xxxxxxxxxxxxxxxxxxxx

# Webhook ID - get from PayPal developer dashboard after creating webhook
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# Supabase Service Role Key (for webhook server-side DB writes)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========================================
# 🎥 Vimeo Configuration
# ========================================
# Get these from: https://developer.vimeo.com/apps
VIMEO_ACCESS_TOKEN=your_vimeo_access_token_here
NEXT_PUBLIC_VIMEO_APP_ID=your_vimeo_app_id_here

# ========================================
# 📧 Email Configuration (Resend)
# ========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@send.noaguralnik.co.il
NOA_EMAIL=studionoapilates.israel@gmail.com

# ========================================
# 🌐 Site Configuration
# ========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Change to your production URL when deploying

# ========================================
# Instructions:
# ========================================
# 1. Copy this file to .env.local: cp env.example .env.local
# 2. Replace ALL placeholder values with your actual keys
# 3. NEVER commit .env.local to git (it's in .gitignore)
# 4. For production, set these in Vercel/Netlify environment variables
